# ─── Database ─────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trialoutline?schema=public"

# ─── Authentication ───────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-change-in-production"

# ─── Anthropic API (optional — can also be set in UI) ────────────
# ANTHROPIC_API_KEY="sk-ant-..."

# ─── File Storage ─────────────────────────────────────────────────
# Local storage directory (default: ./uploads)
# UPLOAD_DIR="/path/to/uploads"

# ─── Redis (optional — for background job queue) ─────────────────
# REDIS_URL="redis://localhost:6379"
